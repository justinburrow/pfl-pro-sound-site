---
// about-us.astro
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";
import Paragraph from "../components/Paragraph.astro";
import { urlForImage } from '../sanity/lib/url-for-image'
import {ABOUT_QUERY} from '../lib/sanity'

const aboutContent = await sanityClient.fetch(ABOUT_QUERY);

const introBlockImageUrl = urlForImage(aboutContent.introBlock.image)
const ownerBlockImageUrl = urlForImage(aboutContent.ownerBlock.image)

// Owner Block Heading - the initial few words colored with the Accent Color
const ACCENT_WORDS = 3;
const words = (aboutContent.ownerBlock.heading ?? "").trim().split(/\s+/);
const accent = words.slice(0, ACCENT_WORDS).join(" ");
const tail   = words.slice(ACCENT_WORDS).join(" ");



const components = {
  block: { normal: Paragraph },
};
//console.log(aboutContent);
---

<Layout>
  <section class="w-full max-w-7xl mx-auto px-6 lg:px-10 py-6 pb-16 my-8 bg-gray-900/50 backdrop-blur-2xl fade">
    <div class="grid grid-cols-6 gap-y-4 gap-x-10 w-full">
      <h1 class="font-oswald font-thinner text-4xl uppercase mb-6 border-b border-brand-white-50 text-brand-white-50 pb-3 col-span-full mt-2 fade">
        <span class="font-semibold text-brand-accent-300">{aboutContent.headingAccent}</span> {aboutContent.headingCopy}</h1>
      <div class="order-2 col-span-full lg:order-1 lg:col-span-3">
        <h2 class="font-geist-mono text-lg font-semibold mb-8 leading-7 fade">
          {aboutContent.introBlock.heading}
        </h2>
        <PortableText value={aboutContent.introBlock.body} components={components} />
      </div>
      <div class="order-1 col-span-full lg:order-2 lg:col-span-3 mb-8 lg:mb-0 fade">
        <img
          class="w-full border border-brand-white-50/30 p-2 aspect-video lg:aspect-square object-cover object-top lg:max-w-none"
          src={introBlockImageUrl.url()}
          alt={aboutContent.introBlock.image.alt}
        />
      </div>
    </div>

    <div class="grid grid-cols-6 gap-y-4 gap-x-10 w-full mt-16">
      <div class="col-span-full md:col-span-2 fade">
        <img
          class="w-full object-contain border border-brand-white-50/30 p-2 lg:p-2"
          src={ownerBlockImageUrl.url()}
          alt="John Wilson, owner of PFL Pro Sound"
          alt={aboutContent.ownerBlock.image.alt}
        />
      </div>
      <div class="col-span-full md:col-span-4 md:max-w-2xl fade">
        <h3 class="font-geist-mono text-lg font-normal mb-8 leading-7">
          <span class="font-bold text-brand-accent-200">{accent}</span>{tail && ` ${tail}`}
        </h3>
        <PortableText value={aboutContent.ownerBlock.body} components={components} />
      </div>
    </div>
  </section>
</Layout>

<style>
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollSmoother } from "gsap/ScrollSmoother";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, ScrollSmoother, SplitText);
  gsap.set('.fade', { opacity: 0 });

  ScrollTrigger.batch('.fade', {
    interval: 0.1,
    batchMax: 4,
    onEnter: batch => gsap.to(batch, { opacity: 1, y: 0, stagger: { each: 0.25 }, overwrite: true }),
    onLeave: batch => gsap.to(batch, { opacity: 0, y: -20, overwrite: true }),
    onEnterBack: batch => gsap.to(batch, { opacity: 1, y: 0, stagger: 0.25, overwrite: true }),
    onLeaveBack: batch => gsap.to(batch, { opacity: 0, y: -20, overwrite: true })
  });
</script>